<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Wakes the sleeping screen when the agent sends a command. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Lets the agent open any launchable app by package (Android 11+ hides other apps otherwise). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>
        <!-- The full app's screen is not reachable in this edition: replace it without a launcher entry. -->
        <activity
            android:name="com.example.hermes.MainActivity"
            android:exported="false"
            tools:node="replace" />

        <activity
            android:name="com.example.hermes.lite.LiteActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
