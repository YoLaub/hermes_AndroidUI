<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below. Secrets (password, session cookie, tokens) are sealed with a Keystore key
     that is never backed up, and backup is disabled in the manifest; everything is excluded anyway. -->
<full-backup-content>
    <exclude domain="file" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
</full-backup-content>
